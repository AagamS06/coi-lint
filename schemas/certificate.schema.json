{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AagamS06/coi-lint/main/schemas/certificate.schema.json",
  "title": "coi-lint certificate",
  "description": "A certificate of insurance normalised for coi-lint (what `coi-lint extract` produces).",
  "type": "object",
  "required": [
    "insured",
    "issued",
    "coverages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "insured": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string"
    },
    "holder": {
      "type": "string"
    },
    "issued": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "description": {
      "type": "string",
      "description": "Description of operations"
    },
    "source": {
      "type": "string"
    },
    "_method": {
      "enum": [
        "form",
        "text",
        "ocr",
        "none"
      ]
    },
    "_unreadable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "effective",
          "expires"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "description": "general_liability | auto | umbrella | workers_comp, or your own kind",
            "examples": [
              "general_liability",
              "auto",
              "umbrella",
              "workers_comp"
            ]
          },
          "policy_number": {
            "type": "string"
          },
          "effective": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Limit name \u2192 whole dollars, e.g. each_occurrence: 1000000"
          },
          "additional_insured": {
            "type": "boolean"
          },
          "waiver_of_subrogation": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
