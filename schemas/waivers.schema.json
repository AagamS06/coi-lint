{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AagamS06/coi-lint/main/schemas/waivers.schema.json",
  "title": "coi-lint waivers",
  "type": "object",
  "required": [
    "waivers"
  ],
  "properties": {
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "insured",
          "rule",
          "reason",
          "until"
        ],
        "additionalProperties": false,
        "properties": {
          "insured": {
            "type": "string"
          },
          "rule": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{1,9}\\d{3}$"
          },
          "coverage": {
            "type": "string",
            "description": "general_liability | auto | umbrella | workers_comp, or your own kind",
            "examples": [
              "general_liability",
              "auto",
              "umbrella",
              "workers_comp"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "approved_by": {
            "type": "string"
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
